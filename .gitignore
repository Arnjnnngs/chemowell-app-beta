node_modules/

# Scratch Playwright verification scripts written during Quality Chain stages (Developer/
# Auditor/Designer self-checks). These hardcode localhost/tmp paths for one-off local runs and
# aren't part of the shipped app — intentionally excluded from every release, not accidentally
# forgotten.
verify_*.mjs
audit_*.mjs
designer_*.mjs
lead_auditor_*.mjs
lead_designer_*.mjs
outputs/**/*.mjs

# Native Android project is generated fresh by CI (npx cap add android) from package.json +
# capacitor.config.ts + app-icons/ — not committed, so it never drifts from the pinned Capacitor
# version. See .github/workflows/android-build.yml.
android/

# Color-direction exploration mockups (throwaway full-app copies with hue-rotated colors, used to
# generate Home-screen screenshots for Aaron to pick a direction from) — not part of the shipped
# app and not meant to be edited/shipped as-is. Once a direction is chosen, the real color change
# gets implemented as a clean edit to index.html itself, not by resurrecting one of these copies.
color-mockups/

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/session-guard.sh" } ] }
    ],
    "Stop": [
      { "matcher": "", "hooks": [ { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/session-guard.sh" } ] }
    ]
  },
  "claudeMdExcludes": [
    "**/care-tracker/CLAUDE.md",
    "**/care-tracker/claude/*.md",
    "**/chemowell-beta/CLAUDE.md",
    "**/chemowell-beta/claude/*.md",
    "**/care-tracker-staging/CLAUDE.md",
    "**/care-tracker-staging/claude/*.md"
  ]
}
